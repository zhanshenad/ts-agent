{
  "name": "ts-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal, dependency-free TypeScript AI agent with tools, skills, memory and sessions.",
  "type": "module",
  "bin": {
    "tsagent": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "serve": "node dist/server.js",
    "dev:web": "npm run build && node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run test:unit && npm run test:api && npm run test:web && npm run test:cli && npm run test:retry && npm run test:contract && npm run test:e2e && npm run test:perf",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:api": "node tests/api.test.mjs",
    "test:cli": "node tests/smoke.test.mjs",
    "test:web": "node tests/server.test.mjs",
    "test:retry": "node tests/retry.test.mjs",
    "test:contract": "node tests/contract.test.mjs",
    "test:e2e": "node tests/e2e.test.mjs",
    "test:perf": "node tests/nonfunctional.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "openai": "^7.39.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.0"
  }
}
