# ---------- LLM (any OpenAI-compatible endpoint) ----------
# OpenAI
# TSA_BASE_URL=https://api.openai.com/v1
# TSA_MODEL=gpt-4o-mini

# DeepSeek
# TSA_BASE_URL=https://api.deepseek.com/v1
# TSA_MODEL=deepseek-chat

# DashScope / Qwen
# TSA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TSA_MODEL=qwen-plus

# Local Ollama
# TSA_BASE_URL=http://localhost:11434/v1
# TSA_MODEL=qwen2.5:7b

TSA_BASE_URL=https://api.openai.com/v1
TSA_API_KEY=sk-replace-me
TSA_MODEL=gpt-4o-mini

# ---------- Behaviour ----------
TSA_TEMPERATURE=0.3
TSA_MAX_ITERATIONS=16
# Auto-approve shell commands (dangerous; only for sandboxes / CI)
TSA_AUTO_APPROVE=false
# Root folder the agent may touch. Defaults to the current directory.
# TSA_WORKSPACE=C:\path\to\project
